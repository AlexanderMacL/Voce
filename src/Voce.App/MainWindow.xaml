<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Voce.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <NavigationView x:Name="Nav"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="True"
                    OpenPaneLength="200"
                    SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Dashboard" Tag="dashboard" Icon="Home" />
            <NavigationViewItem Content="Invoices" Tag="invoices" Icon="Document" />
            <NavigationViewItem Content="New invoice" Tag="new" Icon="Add" />
            <NavigationViewItem Content="Employers" Tag="employers" Icon="People" />
            <NavigationViewItem Content="My details" Tag="profiles" Icon="Contact" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" Padding="32,24,32,24" Navigated="ContentFrame_Navigated" />
    </NavigationView>
</Window>
