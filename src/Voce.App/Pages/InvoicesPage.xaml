<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Voce.App.Pages.InvoicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Voce.App.Pages">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Invoices" Style="{StaticResource PageTitle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="SearchBox" PlaceholderText="Search number, employer, description…" Width="320" TextChanged="Search_TextChanged" />
            <ComboBox x:Name="YearCombo" MinWidth="220" SelectionChanged="Year_SelectionChanged" />
            <CheckBox x:Name="UnpaidOnly" Content="Unpaid only" Checked="Unpaid_Toggled" Unchecked="Unpaid_Toggled" />
        </StackPanel>

        <CommandBar Grid.Row="2" HorizontalAlignment="Left" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False">
            <AppBarButton Icon="Add" Label="New" Click="New_Click" />
            <AppBarButton x:Name="EditButton" Icon="Edit" Label="Amend" Click="Edit_Click" />
            <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="Open PDF" Click="Open_Click" />
            <AppBarButton x:Name="RegenButton" Icon="Refresh" Label="Regenerate PDF" Click="Regenerate_Click" />
            <AppBarButton x:Name="PaidButton" Icon="Accept" Label="Mark paid" Click="Paid_Click" />
            <AppBarButton x:Name="UnpaidButton" Icon="Undo" Label="Mark unpaid" Click="Unpaid_Click" />
            <AppBarButton x:Name="DeleteButton" Icon="Delete" Label="Delete" Click="Delete_Click" />
        </CommandBar>

        <Grid Grid.Row="3" ColumnSpacing="12" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Number" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Date" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Employer" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="Total" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" />
        </Grid>

        <ListView x:Name="List" Grid.Row="4" SelectionMode="Single" SelectionChanged="List_SelectionChanged" DoubleTapped="List_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:InvoiceRow">
                    <Grid ColumnSpacing="12" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Number}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind IssueDateText}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind BillToName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{x:Bind TotalText}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{x:Bind StatusText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
