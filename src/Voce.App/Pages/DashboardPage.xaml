<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Voce.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Voce.Core.Models">
    <ScrollViewer>
        <StackPanel Spacing="16">
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="PeriodCombo" Header="Period" MinWidth="280" SelectionChanged="Period_Changed" />
                <CalendarDatePicker x:Name="FromDate" Header="From" DateFormat="{}{day.integer}/{month.integer}/{year.full}" DateChanged="Custom_DateChanged" />
                <CalendarDatePicker x:Name="ToDate" Header="To" DateFormat="{}{day.integer}/{month.integer}/{year.full}" DateChanged="Custom_DateChanged" />
                <Button Content="Export CSV…" VerticalAlignment="Bottom" Click="ExportCsv_Click" />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="Invoices generated" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="CountText" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="Total invoiced" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="TotalText" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="Paid" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="PaidText" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="3">
                    <StackPanel>
                        <TextBlock Text="Outstanding" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="OutstandingText" Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock x:Name="OverdueText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Unpaid invoices (all periods)" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock x:Name="NoUnpaidText" Text="Nothing outstanding." Visibility="Collapsed" />
            <ListView x:Name="UnpaidList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Unpaid_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Invoice">
                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Number}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{x:Bind IssueDateText}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind BillToName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind TotalText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{x:Bind DueDateText}" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
