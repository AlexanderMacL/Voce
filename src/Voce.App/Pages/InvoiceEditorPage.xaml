<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Voce.App.Pages.InvoiceEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Voce.App.Pages">
    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" Text="New invoice" Style="{StaticResource PageTitle}" />
            <InfoBar x:Name="PaidInfo" IsOpen="False" IsClosable="False" Severity="Success" />

            <Grid ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <ComboBox x:Name="ProfileCombo" Header="My details" HorizontalAlignment="Stretch" SelectionChanged="Profile_Changed" />
                <ComboBox x:Name="EmployerCombo" Grid.Column="1" Header="Employer" PlaceholderText="Choose an employer" HorizontalAlignment="Stretch" SelectionChanged="Employer_Changed" />
                <ComboBox x:Name="EventCombo" Grid.Column="2" Header="Event (fills the first line)" PlaceholderText="Choose an event" HorizontalAlignment="Stretch" SelectionChanged="Event_Changed" />
                <CalendarDatePicker x:Name="IssueDatePicker" Grid.Row="1" Header="Invoice date" HorizontalAlignment="Stretch" DateFormat="{}{day.integer}/{month.integer}/{year.full}" DateChanged="IssueDate_Changed" />
                <CalendarDatePicker x:Name="DueDatePicker" Grid.Row="1" Grid.Column="1" Header="Payment due" HorizontalAlignment="Stretch" DateFormat="{}{day.integer}/{month.integer}/{year.full}" DateChanged="DueDate_Changed" />
                <CalendarDatePicker x:Name="EventDatePicker" Grid.Row="1" Grid.Column="2" Header="Event date (optional)" PlaceholderText="None" HorizontalAlignment="Stretch" DateFormat="{}{day.integer}/{month.integer}/{year.full}" DateChanged="EventDate_Changed" />
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="BillToNameBox" Header="Bill to" />
                <TextBox x:Name="BillToAddressBox" Grid.Column="1" Header="Bill-to address" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock Text="Lines" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Text="Type | to split a line into columns on the PDF. The fee can be left blank." />
            </StackPanel>

            <ItemsControl x:Name="LinesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:LineItem">
                        <Grid ColumnSpacing="8" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind Description}" PlaceholderText="Reason" TextChanged="LineText_Changed" />
                            <NumberBox Grid.Column="1" Value="{x:Bind Fee}" PlaceholderText="Fee (£)" Loaded="Fee_Loaded" ValueChanged="Fee_Changed" />
                            <Button Grid.Column="2" Click="RemoveLine_Click" ToolTipService.ToolTip="Remove line">
                                <SymbolIcon Symbol="Delete" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Add line" Click="AddLine_Click" />
                <Button Content="Reset first line from template" Click="ResetFirstLine_Click" />
            </StackPanel>

            <TextBlock x:Name="TotalText" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Right" />

            <TextBox x:Name="NotesBox" Header="Notes (printed on the invoice)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,24">
                <Button x:Name="SaveButton" Content="Save &amp; generate PDF" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                <Button Content="Cancel" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
