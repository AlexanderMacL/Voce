<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Voce.App.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="My details" Style="{StaticResource PageTitle}" Grid.ColumnSpan="2" />

        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button Content="Add set of details" Click="Add_Click" />
            <ListView x:Name="ProfileList" Grid.Row="1" SelectionChanged="ProfileList_SelectionChanged" />
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="1">
            <StackPanel x:Name="Form" Spacing="12" MaxWidth="720" HorizontalAlignment="Left" Visibility="Collapsed">
                <TextBox x:Name="LabelBox" Header="Label (only shown in this app), e.g. &quot;Main account&quot;" />
                <CheckBox x:Name="DefaultCheck" Content="Use by default for new invoices" />

                <TextBlock Text="Printed on the invoice" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBox x:Name="SingerNameBox" Header="Name" />
                    <TextBox x:Name="VoicePartBox" Grid.Column="1" Header="Voice part, e.g. Soprano" />
                </Grid>
                <TextBox x:Name="AddressBox" Header="Address" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBox x:Name="EmailBox" Header="Email" />
                    <TextBox x:Name="PhoneBox" Grid.Column="1" Header="Phone" />
                    <TextBox x:Name="UtrBox" Grid.Column="2" Header="UTR (optional)" />
                </Grid>

                <TextBlock Text="Bank details" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBox x:Name="AccountNameBox" Header="Account name" />
                    <TextBox x:Name="BankNameBox" Grid.Column="1" Header="Bank" />
                    <TextBox x:Name="SortCodeBox" Grid.Row="1" Header="Sort code" PlaceholderText="00-00-00" />
                    <TextBox x:Name="AccountNumberBox" Grid.Row="1" Grid.Column="1" Header="Account number" />
                </Grid>

                <TextBlock Text="Invoice defaults" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <NumberBox x:Name="TermsBox" Header="Payment terms (days)" Minimum="0" Maximum="365" SpinButtonPlacementMode="Inline" Width="200" HorizontalAlignment="Left" />
                <TextBox x:Name="TemplateBox" Header="Default first line" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap">
                    Use | to separate columns. Placeholders: {NAME} your name, {VOICE} voice part, {EMPLOYER}, {EVENT}, {DATE} event date,
                    {FEE} puts the event's default fee in the fee column. Example: {NAME} | {VOICE} | {FEE}
                </TextBlock>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,24">
                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
